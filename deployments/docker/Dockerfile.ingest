FROM golang:1.23-alpine AS builder
RUN apk add --no-cache git ca-certificates
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /rollout-ingest ./cmd/rollout-ingest

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /rollout-ingest /usr/local/bin/rollout-ingest
EXPOSE 8082
ENTRYPOINT ["rollout-ingest"]
