FROM golang:1.23-alpine AS builder
RUN apk add --no-cache git ca-certificates
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /rollout-server ./cmd/rollout-server

FROM alpine:3.19
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /rollout-server /usr/local/bin/rollout-server
EXPOSE 8080
ENTRYPOINT ["rollout-server"]
